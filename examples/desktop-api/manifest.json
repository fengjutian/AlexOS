{
  "schemaVersion": 1,
  "id": "com.alex.desktop_api_demo",
  "name": "Desktop API Demo",
  "version": "0.1.0",
  "frontend": {
    "entry": "frontend/dist/index.html",
    "build": { "command": "npm", "args": ["run", "build"] },
    "dev": {
      "command": "npm",
      "args": ["run", "dev", "--", "--host", "127.0.0.1", "--port", "5174", "--strictPort"],
      "install": { "command": "npm", "args": ["install"] },
      "cwd": "frontend",
      "url": "http://127.0.0.1:5174"
    }
  },
  "permissions": [
    { "name": "filesystem.read", "paths": ["data"] },
    { "name": "filesystem.write", "paths": ["data"] },
    { "name": "filesystem.watch", "paths": ["data"] },
    { "name": "filesystem.drop" },
    { "name": "dialog.open" },
    { "name": "dialog.save" },
    { "name": "storage" },
    { "name": "paths" },
    { "name": "clipboard.read" },
    { "name": "clipboard.write" },
    { "name": "window.manage" },
    { "name": "window.open" },
    { "name": "menu.manage" },
    { "name": "shortcut.register" },
    { "name": "notification.show" },
    { "name": "network.fetch", "origins": ["https://example.com"] },
    { "name": "system.openExternal", "origins": ["https://example.com"] }
  ]
}
