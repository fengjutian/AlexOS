{
  "schemaVersion": 1,
  "id": "com.example.react",
  "name": "my-react-app",
  "version": "0.1.0",
  "frontend": {
    "entry": "frontend/dist/index.html",
    "build": {
      "command": "npm",
      "args": ["run", "build"]
    }
  },
  "backend": {
    "runtime": "node",
    "entry": "backend/index.js",
    "mode": "service",
    "healthCheck": { "path": "/health", "timeoutMs": 5000 }
  },
  "permissions": [
    { "name": "runtime.invoke" },
    { "name": "runtime.manage" },
    { "name": "storage" },
    { "name": "clipboard.write" },
    { "name": "window.manage" }
  ]
}
