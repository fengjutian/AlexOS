{
  "version": 1,
  "errors": ["INVALID_PARAMS", "PERMISSION_DENIED", "OPERATION_FAILED", "DEADLINE_EXCEEDED", "HOST_BUSY", "METHOD_NOT_FOUND"],
  "domains": {
    "filesystem": { "permission": "filesystem.*", "execution": "blocking" },
    "storage": { "permission": "storage", "execution": "blocking" },
    "paths": { "permission": "none", "execution": "inline" },
    "dialog": { "permission": "dialog.*", "execution": "native" },
    "clipboard": { "permission": "clipboard.*", "execution": "native" },
    "system": { "permission": "method-specific", "execution": "blocking" },
    "window": { "permission": "window.*", "execution": "native" },
    "menu": { "permission": "menu", "execution": "native" },
    "tray": { "permission": "tray", "execution": "native" },
    "shortcuts": { "permission": "shortcuts", "execution": "native" },
    "notification": { "permission": "notification", "execution": "native" },
    "runtime": { "permission": "runtime", "execution": "blocking" },
    "events": { "permission": "none", "execution": "inline" },
    "process": { "permission": "process.*", "execution": "blocking" },
    "net": { "permission": "network.fetch", "execution": "blocking" }
  },
  "capabilities": {
    "always": [
      "filesystem.readText", "filesystem.readBinary", "filesystem.writeText", "filesystem.writeBinary",
      "filesystem.exists", "filesystem.stat", "filesystem.readDir", "filesystem.createDir",
      "filesystem.remove", "filesystem.rename", "filesystem.copy", "filesystem.watch", "filesystem.unwatch",
      "storage.get", "storage.set", "storage.delete", "storage.clear", "storage.keys",
      "paths.dataDir", "paths.cacheDir", "paths.tempDir",
      "dialog.openFile", "dialog.openFiles", "dialog.openDirectory", "dialog.saveFile",
      "clipboard.readText", "clipboard.writeText", "system.info", "system.capabilities",
      "system.requestPermission", "system.openExternal", "system.listApps", "system.listExtensions",
      "system.install", "system.uninstall", "system.updateStart", "system.updateTasks", "system.updateCancel", "system.updateRetry", "system.listPermissions", "system.setPermission",
      "system.listTrustedPublishers", "system.readAuditLog", "window.setTitle", "window.minimize",
      "window.maximize", "window.close", "notification.show", "runtime.invoke", "runtime.status",
      "runtime.restart", "runtime.cancel", "events.subscribe", "events.unsubscribe",
      "system.instances.create", "system.instances.start", "system.instances.stop",
      "system.instances.restart", "system.instances.remove", "system.instances.inspect",
      "system.instances.list", "system.instances.logs", "process.spawn", "process.kill", "net.fetch"
    ],
    "nativeDesktop": [
      "window.create", "window.list", "window.getBounds", "window.setBounds", "window.setFullscreen",
      "window.isFullscreen", "window.destroy", "menu.setApplicationMenu", "menu.setContextMenu",
      "tray.create", "tray.destroy", "shortcuts.register", "shortcuts.unregister", "shortcuts.list"
    ],
    "experimental": []
  },
  "$defs": {
    "Empty": { "type": "object", "additionalProperties": false },
    "InstanceId": { "type": "object", "properties": { "instanceId": { "type": "string", "minLength": 1 } }, "required": ["instanceId"], "additionalProperties": false },
    "UpdateTask": { "type": "object", "properties": { "id": { "type": "string" }, "appId": { "type": "string" }, "manifestUrl": { "type": "string", "format": "uri" }, "channel": { "enum": ["stable", "beta", "dev"] }, "state": { "type": "string" }, "stage": { "type": "string" }, "progress": { "type": "integer", "minimum": 0, "maximum": 100 }, "error": { "type": ["string", "null"] } }, "required": ["id", "appId", "manifestUrl", "channel", "state", "stage", "progress", "error"], "additionalProperties": false }
  },
  "methods": {
    "system.updateStart": { "params": { "type": "object", "properties": { "id": { "type": "string", "minLength": 1 }, "manifestUrl": { "type": "string", "format": "uri" }, "channel": { "enum": ["stable", "beta", "dev"] } }, "required": ["id", "manifestUrl"], "additionalProperties": false }, "result": { "$ref": "#/$defs/UpdateTask" } },
    "system.updateTasks": { "params": { "$ref": "#/$defs/Empty" }, "result": { "type": "object", "properties": { "tasks": { "type": "array", "items": { "$ref": "#/$defs/UpdateTask" } } }, "required": ["tasks"], "additionalProperties": false } },
    "system.updateCancel": { "params": { "type": "object", "properties": { "taskId": { "type": "string", "minLength": 1 } }, "required": ["taskId"], "additionalProperties": false }, "result": { "type": "object", "properties": { "cancelled": { "type": "boolean" } }, "required": ["cancelled"], "additionalProperties": false } },
    "system.updateRetry": { "params": { "type": "object", "properties": { "taskId": { "type": "string", "minLength": 1 } }, "required": ["taskId"], "additionalProperties": false }, "result": { "$ref": "#/$defs/UpdateTask" } },
    "system.instances.start": { "params": { "$ref": "#/$defs/InstanceId" }, "result": { "type": "object" } },
    "system.instances.stop": { "params": { "type": "object", "properties": { "instanceId": { "type": "string", "minLength": 1 }, "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 } }, "required": ["instanceId"], "additionalProperties": false }, "result": { "type": "object" } },
    "system.instances.restart": { "params": { "$ref": "#/$defs/InstanceId" }, "result": { "type": "object" } },
    "system.instances.remove": { "params": { "type": "object", "properties": { "instanceId": { "type": "string", "minLength": 1 }, "deleteData": { "type": "boolean" } }, "required": ["instanceId"], "additionalProperties": false }, "result": { "type": "object", "properties": { "removed": { "const": true } }, "required": ["removed"], "additionalProperties": false } },
    "system.instances.inspect": { "params": { "$ref": "#/$defs/InstanceId" }, "result": { "type": "object" } },
    "system.instances.logs": { "params": { "type": "object", "properties": { "instanceId": { "type": "string", "minLength": 1 }, "tail": { "type": "integer", "minimum": 1, "maximum": 5000 } }, "required": ["instanceId"], "additionalProperties": false }, "result": { "type": "object", "properties": { "entries": { "type": "array", "items": { "type": "object" } } }, "required": ["entries"], "additionalProperties": false } }
  },
  "events": {
    "menu.clicked": "{ id: string }",
    "tray.clicked": "{ id: string }",
    "shortcut.triggered": "{ accelerator: string }"
  }
}
