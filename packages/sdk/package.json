{
  "name": "@alex/sdk",
  "version": "0.1.0",
  "description": "Typed JavaScript SDK for Alex OS applications",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "desktop-api.schema.json",
    "schema.generated.d.ts"
  ],
  "scripts": {
    "generate": "node generate-schema.mjs",
    "check:schema": "node generate-schema.mjs --check"
  },
  "sideEffects": false,
  "license": "MIT"
}
